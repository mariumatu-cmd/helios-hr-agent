# ---- LLM provider -----------------------------------------------------------
# Primary provider: "groq" or "gemini". The other is used as automatic fallback.
LLM_PROVIDER=groq

# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Agent ------------------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_TEMPERATURE=0.0

# ---- Retrieval --------------------------------------------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_K=6
RETRIEVAL_POOL=50
RETRIEVAL_MODE=hybrid

# ---- MCP --------------------------------------------------------------------
# "stdio" (default, single-service friendly) or "http" (separate MCP service)
MCP_TRANSPORT=stdio
# Only used when MCP_TRANSPORT=http
MCP_SERVER_URL=http://127.0.0.1:8765/mcp

# ---- App --------------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
SEED=42
