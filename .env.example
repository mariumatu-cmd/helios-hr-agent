# ---- LLM provider -----------------------------------------------------------
# Primary provider: "groq" or "gemini". Degradation is a chain of models, not
# just of providers: Groq meters its free tier per model, so GROQ_FALLBACK_MODEL
# is a genuinely separate token budget and is tried before crossing to Gemini.
LLM_PROVIDER=groq

# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Comma-separated, tried in order after GROQ_MODEL. Groq meters tokens-per-
# minute PER MODEL, so each entry is a separate 8,000-token budget. That is the
# difference between roughly one agent step per minute and enough headroom to
# finish a multi-step task. Every entry must support tool calling: Groq's
# `compound` models advertise 70,000 TPM but reject a caller-supplied tool
# manifest with HTTP 400, so they cannot drive this agent. Set empty to disable.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,qwen/qwen3.6-27b

# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---- Agent ------------------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_TEMPERATURE=0.0
# Cap on completion length. Groq reserves this against the per-minute budget
# whether the model uses it or not, so every 1,000 here is 1,000 fewer
# available for the prompt. ~900 words is ample for a cited HR answer.
LLM_MAX_TOKENS=1200
# Max estimated prompt tokens per step. Derived, not guessed -- run
# `python scripts/measure_context.py` to reproduce:
#   system prompt ~595 + 12-tool MCP manifest ~2,709 = ~3,304 fixed per step.
# That floor is resent on every step, so it also decides how many LLM calls per
# minute the agent gets at all. Budget + LLM_MAX_TOKENS must clear Groq's 8,000
# TPM ceiling with room for estimation error: 6,200 + 1,200 = 7,400. The
# orchestrator compacts the oldest tool results to stay under the budget,
# always preserving citations.
CONTEXT_TOKEN_BUDGET=6200

# ---- Retrieval --------------------------------------------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_K=6
RETRIEVAL_POOL=50
RETRIEVAL_MODE=hybrid

# ---- MCP --------------------------------------------------------------------
# "stdio" (default, single-service friendly) or "http" (separate MCP service)
MCP_TRANSPORT=stdio
# Only used when MCP_TRANSPORT=http
MCP_SERVER_URL=http://127.0.0.1:8765/mcp

# ---- App --------------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO
SEED=42
